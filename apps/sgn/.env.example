# ==============================================================================
# CONFIGURAÇÕES NATIVAS DO DJANGO
# ==============================================================================
# Chave mestra de segurança (pode ser gerada com 'get_random_secret_key')
SECRET_KEY=
# Modo de depuração: Use 'False' em produção e 'True' em desenvolvimento
DEBUG=False
# Domínios permitidos: Separe por vírgula (ex: localhost,api.gvendas.app.br)
ALLOWED_HOSTS=localhost,127.0.0.1
# Origens confiáveis para CSRF (ex: https://gvendas.app.br,http://localhost:3001)
CSRF_TRUSTED_ORIGINS=

# ==============================================================================
# BANCO DE DADOS (POSTGRESQL)
# ==============================================================================
# String de conexão completa (postgres://usuario:senha@host:porta/nome_do_banco)
DATABASE_URL=

# ==============================================================================
# INFRAESTRUTURA E DOMÍNIOS ESPECÍFICOS
# ==============================================================================
# Domínio principal da API
API_DOMAIN=
# Domínio do CDN para arquivos estáticos/media públicos
MEDIA_DOMAIN=
# Domínio para armazenamento de arquivos privados/protegidos
STORAGE_DOMAIN=
# Nome do container Docker ou Host do serviço de WhatsApp (Baileys)
WHATSAPP_HOST=
# Porta de comunicação com o serviço de WhatsApp
WHATSAPP_PORT=
# Domínios banidos para cadastro no sistema (separados por vírgula)
BANNED_DOMAINS=

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL E BUSCA (GOOGLE)
# ==============================================================================
# API Key geral do Google Cloud Console
GOOGLE_API_KEY=
# API Key exclusiva para o Google AI Studio (Gemini 1.5 Flash)
GEMINI_API_KEY=

# ==============================================================================
# INTEGRAÇÕES DE PAGAMENTO E FISCAL
# ==============================================================================
# Token de aplicação para o PagBank
TOKEN_APLICATION_PAGBANK=
# Credenciais do checkout/API do PagSeguro
PAGSEGURO_CLIENT_ID=
PAGSEGURO_CLIENT_SECRET=
# Credenciais do Mercado Pago
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
# Credenciais de autenticação Basic para consulta de GTIN (RSCISTEMAS)
GTIN_RSCISTEMAS_BASIC=

# ==============================================================================
# FILAS DE TAREFAS (CELERY & REDIS)
# ==============================================================================
# URL de conexão com o Redis para o Broker do Celery
CELERY_BROKER_URL=redis://localhost:6379/0

# ==============================================================================
# SERVIDOR DE EMAIL (SMTP)
# ==============================================================================
# Endereço de email usado para disparos automáticos
EMAIL_HOST_USER=
# Senha de aplicativo (App Password) do servidor de email
EMAIL_HOST_PASSWORD=

# ==============================================================================
# NOTIFICAÇÕES PUSH
# ==============================================================================
# Chave Privada VAPID para Web Push (PWA)
VAPID_PRIVATE_KEY=
# Caminho do arquivo JSON de conta de serviço do Firebase (Android)
FIREBASE_SERVICE_ACCOUNT=
# ID do projeto no Firebase
FIREBASE_PROJECT_ID=
# Token JWT para notificações Apple (iOS)
APNS_JWT=
# Identificador do pacote do aplicativo iOS (Bundle ID)
IOS_BUNDLE_ID=
