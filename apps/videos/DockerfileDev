FROM node:18-bullseye-slim

# Instala FFmpeg e ferramentas de utilidade
RUN apt-get update && apt-get install -y \
    ffmpeg \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Instala o nodemon globalmente
RUN npm install -g nodemon

WORKDIR /app

# Lógica automática: 
# 1. Verifica se package.json existe, se não, cria um padrão (npm init -y)
# 2. Instala as dependências de uma vez só
RUN [ -f package.json ] || npm init -y && \
    npm install express multer fluent-ffmpeg cors

# Pastas de trabalho necessárias para o processamento de vídeos
RUN mkdir -p /var/www/videos /app/uploads

# Mantém o contêiner vivo para você desenvolver lá dentro
CMD ["tail", "-f", "/dev/null"]
