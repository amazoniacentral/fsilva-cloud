FROM node:18-bullseye-slim

# 1. Instalação de dependências do sistema
# ffmpeg: para processamento de vídeo
# procps: útil para debug e monitoramento
RUN apt-get update && apt-get install -y \
    ffmpeg \
    procps \
    && rm -rf /var/lib/apt/lists/*

# 2. Instalação de ferramentas globais do Node
RUN npm install -g nodemon

# 3. Definição do diretório de trabalho
WORKDIR /app

# 4. Lógica automática de dependências
# - Verifica se o package.json existe. 
# - Se não existir (||), cria um automaticamente com "npm init -y".
# - Em seguida (&&), instala as bibliotecas necessárias.
RUN [ -f package.json ] || npm init -y && \
    npm install express multer fluent-ffmpeg cors

# 5. Criação das pastas de processamento de vídeos
RUN mkdir -p /var/www/videos /app/uploads

# 6. Mantém o contêiner rodando (Modo Desenvolvimento)
# O "tail -f /dev/null" mantém o contêiner vivo para você entrar nele 
# e rodar comandos ou editar arquivos via volume mapeado.
CMD ["tail", "-f", "/dev/null"]
