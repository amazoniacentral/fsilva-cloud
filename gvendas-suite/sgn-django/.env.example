# Configurações de Domínio
DOMAIN=django.seu-dominio.com
ALLOWED_HOSTS=django.seu-dominio.com,localhost

# Banco de Dados (Apontando para o container 'postgres' que você já tem)
DATABASE_URL=postgres://usuario:senha@postgres:5432/nome_do_banco

# Redis (Apontando para o seu 'redis-global')
CELERY_BROKER_URL=redis://redis:6379/0

# Django Settings
DEBUG=0
SECRET_KEY=sua_chave_secreta_aqui
