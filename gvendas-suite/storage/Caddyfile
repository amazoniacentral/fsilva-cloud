:80 {
    # Pega o ID da empresa vindo do Traefik
    @empresa_id header X-Empresa-Id *
    
    # Define a raiz baseada no ID (Isolamento total)
    #root * /storage/{header.X-Empresa-Id}
    root * /storage
    
    
    # Ativa o servidor de arquivos com visual moderno e busca
   # file_server browse
    file_server browse {
        template /etc/caddy/template.html
    }
    
    # Log para debug
    log {
        output stdout
    }
}
