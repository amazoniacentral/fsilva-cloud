
# Mapeia o header enviado pelo Traefik para uma variável interna
map $http_x_empresa_id $empresa_path {
    default "anonimo";
    "~.+"    $http_x_empresa_id;
}

server {
    listen 80;
    server_name localhost; # Altere para storage.francsilva.com.br, etc.
    
    # Logs para depuração (Remova em produção se houver muito tráfego)
    access_log /var/log/nginx/access.log combined;
    error_log /var/log/nginx/error.log debug;

    root /storage;

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|csv|xml|xlsx|pdf|zip)$ {
        # 3. BLOQUEIO TOTAL DE CACHE
        # Se o ID da empresa for 123, o Nginx buscará em /storage/123/
        root /storage/$empresa_path;
        
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        
        # 4. CORS RESTRITO
        add_header Access-Control-Allow-Origin "*" always;
        
        # 5. OTIMIZAÇÕES DE REDE
        sendfile on;
        tcp_nopush on;
        tcp_nodelay on;
        
        # 6. SEGURANÇA MÁXIMA
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none';" always;

        # 7. BUSCA O ARQUIVO FÍSICO
        # root /usr/share/nginx/documentos/privados;
        try_files $uri =404;
    }
}
