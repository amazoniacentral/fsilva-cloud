# --- DJANGO ---
DEBUG=True
ALLOWED_HOSTS=localhost
CSRF_TRUSTED_ORIGINS=localhost:8080


# Configurações de Tunel
TUNNEL_TOKEN=seu_token_aqui_sem_aspas